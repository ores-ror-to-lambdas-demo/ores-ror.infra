{
  "profile": "gs-ruby-isolates-v3",
  "build_target_env": "ORES_BUILD_TARGET=graal",
  "generated_manifest": "generated/graal/manifest.json",
  "shared_source": "generated/graal/common.rb",
  "isolation_granularities": [
    "route",
    "group"
  ],
  "rails_boot": false,
  "rails_application_initialized": false,
  "engine_scope": "process-shared",
  "context_lifetime": "isolate",
  "context_model": "one-long-lived-context-per-route-or-group-isolate",
  "request_state": "explicit-per-invocation",
  "thread_identity_is_request_identity": false,
  "max_concurrency_per_isolate": 5,
  "max_isolate_age_seconds": 1800,
  "idle_retire_seconds": 300,
  "hard_cancel_scope": "isolate",
  "replacement_before_drain": true,
  "host_http_binding": "ores_gs_http",
  "guest_created_threads": false,
  "child_processes": false,
  "native_ffi": false,
  "raw_sockets": false,
  "guest_filesystem": false,
  "database_transport": "host-http",
  "request_identity": "x-request-id",
  "rails_route_authority": "config/routes.rb",
  "route_handler_authority": "generated app/controllers/**/handler.rb sidecars",
  "language_context": "ruby",
  "contexts_per_isolate": 1,
  "request_multiplexing": true,
  "worker_definition": "runtime-isolation-cell-not-host-thread",
  "host_thread_pool_scope": "process-shared",
  "host_thread_pool_size_source": "infra-runtime-config",
  "host_threads_reused_across_isolates": true,
  "host_thread_affinity": "none",
  "max_execution_concurrency_per_isolate": 5
}
